<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpscPipelines\SpscPipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes diagnostic-only telemetry (SlotDispatchedCount / TpOverflowedCount)
         to the benchmark project; not part of the public contract. -->
    <InternalsVisibleTo Include="SpscPipelines.HotHandoff.Benchmarks" />
  </ItemGroup>

</Project>
